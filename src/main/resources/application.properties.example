spring.application.name=Gerenciador_Eventos

spring.datasource.url=jdbc:mysql://localhost:3306/gerenciador_eventos?useUnicode=true&characterEncoding=UTF-8&serverTimezone=America/Sao_Paulo
spring.datasource.username=SEU_USUARIO
spring.datasource.password=SUA_SENHA
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true

api.security.token.secret=${JWT_SECRET:12345678}

# CORS - endereço(s) do frontend que podem chamar a API pelo navegador. Vários
# domínios separados por vírgula, sem espaço (ex: "https://meusite.com,https://www.meusite.com").
# Em desenvolvimento local, os valores padrão já cobrem React/Vite rodando na própria máquina.
api.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:3000,http://localhost:5173}